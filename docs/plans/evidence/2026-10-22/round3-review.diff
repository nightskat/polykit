+
+    if not valid_events:
+        return {"authed": None, "evidence_ts": None, "reason": "no_evidence", "record": None}
+
+    # Sắp xếp theo thời gian tăng dần, tie-breaker priority (auth_failure=1 thắng ok=0)
+    valid_events.sort(key=lambda x: (x[0], x[1]))
